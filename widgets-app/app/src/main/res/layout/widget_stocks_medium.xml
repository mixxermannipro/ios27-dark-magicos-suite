<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ios_widget"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Row 1 -->
    <LinearLayout
        android:id="@+id/stock_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="105dp" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/sm_sym_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S&amp;P 500" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/sm_name_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="^GSPC" android:textColor="#8E8E93" android:textSize="10sp" />
        </LinearLayout>
        <ImageView android:id="@+id/sm_chart_1" android:layout_width="0dp" android:layout_height="26dp" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:scaleType="fitXY" />
        <LinearLayout android:layout_width="76dp" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
            <TextView android:id="@+id/sm_price_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:text="5980.2" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/sm_chg_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_green" android:fontFeatureSettings="tnum" android:paddingHorizontal="5dp" android:paddingVertical="1dp" android:text="+0.6%" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:id="@+id/stock_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="105dp" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/sm_sym_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NVDA" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/sm_name_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="NVIDIA" android:textColor="#8E8E93" android:textSize="10sp" />
        </LinearLayout>
        <ImageView android:id="@+id/sm_chart_2" android:layout_width="0dp" android:layout_height="26dp" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:scaleType="fitXY" />
        <LinearLayout android:layout_width="76dp" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
            <TextView android:id="@+id/sm_price_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:text="142.50" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/sm_chg_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_green" android:fontFeatureSettings="tnum" android:paddingHorizontal="5dp" android:paddingVertical="1dp" android:text="+1.8%" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:id="@+id/stock_row_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="105dp" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/sm_sym_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AAPL" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/sm_name_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Apple" android:textColor="#8E8E93" android:textSize="10sp" />
        </LinearLayout>
        <ImageView android:id="@+id/sm_chart_3" android:layout_width="0dp" android:layout_height="26dp" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:scaleType="fitXY" />
        <LinearLayout android:layout_width="76dp" android:layout_height="wrap_content" android:gravity="end" android:orientation="vertical">
            <TextView android:id="@+id/sm_price_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:text="228.10" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/sm_chg_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge_red" android:fontFeatureSettings="tnum" android:paddingHorizontal="5dp" android:paddingVertical="1dp" android:text="-0.4%" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
