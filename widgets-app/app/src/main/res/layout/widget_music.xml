<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ios_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/music_cover"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <TextView
            android:id="@+id/music_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="NOW PLAYING"
            android:textColor="#FF3B30"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/music_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Keine Wiedergabe"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/music_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Spotify / Apple Music / YT Music"
            android:textColor="#AEAEB2"
            android:textSize="12sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/music_btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_music_btn"
                android:contentDescription="Zurück"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_media_prev" />

            <ImageButton
                android:id="@+id/music_btn_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="14dp"
                android:background="@drawable/bg_music_btn"
                android:contentDescription="Play/Pause"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_media_play" />

            <ImageButton
                android:id="@+id/music_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_music_btn"
                android:contentDescription="Weiter"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_media_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
